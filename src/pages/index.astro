---
import Layout from "../layouts/Layout.astro";
import PortfolioGallery from "../components/PortfolioGallery.astro";

export const prerender = true;
---

<Layout>
    <div class="pg-index">
        <main class="content-grid min-h-screen">
            <div class="content-col">
                <header class="pg-header">
                    <a href="/" class="index-link">
                        <img
                            src="/logo/cadmus-logo.svg"
                            width="140"
                            alt="Cadmus Design Studio"
                        />
                    </a>
                </header>
                <section class="content-section">
                    <div class="ct-grid">
                        <h1 class="ct-title">Thoughtful product design from concept to launch.</h1>
                        <div class="ct-desc">
                            <p class="desc-item">
                                Cadmus is a product design studio helping early-stage founders turn
                                complex ideas into intuitive, market-ready products that move the needle.<br
                                /><br />
                                I partner with early-stage teams to go from napkin sketch to polished
                                launch.<br /><br />
                                From web apps and mobile products to marketing sites and the occasional
                                brand design, I'd love to hear more about what you're building.
                            </p>
                        </div>
                        <div class="ct-actions mt-3">
                            <a
                                href="mailto:nos.onaiwu@gmail.com"
                                rel="noopener noreferrer"
                                class="btn bg-stone-950 px-4 py-2 text-sm font-medium text-white inline-flex items-center gap-2 rounded-md transition-colors hover:bg-stone-800 hover:shadow-[0_0_0_4px_#d6d3d1] active:bg-stone-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-500"
                            >
                                Start a project
                            </a>
                        </div>
                    </div>
                </section>
            </div>
            <div class="image-col">
                <PortfolioGallery />
            </div>
        </main>
    </div>
</Layout>
